QTabWidget::pane {
    border: 1px solid #2a2a3f;
    border-top: 2px solid #ff6b9d;
    background: #0a0a0f;
}

QTabBar::close-button {
    image: url(:/icons/tab-close-button);
    subcontrol-position: right;
}

QTabBar {
    background: #0a0a0f;
}

QTabBar::tab {
    height: 30px;
    background: #0a0a0f;
    color: #6666aa;
    border: none;
    border-right: 1px solid #2a2a3f;
    border-bottom: none;
    padding: 0 20px;
    border-radius: 0px;
    font-size: 12px;
}

QTabBar::tab:selected {
    background: #111118;
    color: #ff6b9d;
    border-top: 3px solid #ff6b9d;
    border-right: 1px solid #2a2a3f;
    font-weight: bold;
}

QTabBar::tab:hover:!selected {
    background: #111118;
    color: #f0f0ee;
}
